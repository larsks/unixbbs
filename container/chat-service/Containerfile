FROM docker.io/golang:1.26-alpine AS build

ARG GOMAXPROCS

WORKDIR /src
COPY chat-service/go.mod chat-service/go.sum ./
RUN go mod download
COPY chat-service/ ./

# modernc.org/sqlite is a pure-Go SQLite driver, so CGO_ENABLED=0 works
# fine here -- no C toolchain needed in either stage.
RUN CGO_ENABLED=0 go build -o /out/chat-service .

FROM base

COPY --from=build /out/chat-service /usr/local/bin/chat-service

ENTRYPOINT ["/usr/local/bin/chat-service"]
