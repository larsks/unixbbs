FROM docker.io/golang:1.26-alpine AS build

WORKDIR /src
COPY api-service/go.mod api-service/go.sum ./
RUN go mod download
COPY api-service/ ./

ARG GOMAXPROCS

# modernc.org/sqlite is a pure-Go SQLite driver, so CGO_ENABLED=0 works
# fine here -- no C toolchain needed in either stage.
RUN CGO_ENABLED=0 go build -o /out/api-service .

FROM base

COPY --from=build /out/api-service /usr/local/bin/api-service

# api-service must run as root (the default here, no USER directive):
# provisioning a user's first login chowns mail/<uid> and home/<uid> to
# an arbitrary uid, and only root can chown to a uid other than its own
# (see DESIGN.md §5's provisioning step and internal/provision).
ENTRYPOINT ["/usr/local/bin/api-service"]
