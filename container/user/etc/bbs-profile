#!/bin/sh
# Sourced by the entrypoint before exec'ing the interactive shell.

export PS1="$(id -un)$ "
export PAGER=less
export EDITOR=ex
export VISUAL=ex

if [ "$TERM" = dumb ]; then
  export LESS=-dE
  export LANG=C
  export LC_ALL=C
fi

# Prevent annoying double-echo when using character-buffered clients.
if [ "${BBS_DISABLE_ECHO:-}" = 1 ]; then
  stty -echo
fi

cat <<'EOF'

Welcome to the BBS.

  help  -- access online help
  mail  -- read and send mail
  news  -- read bbs news
  users -- list known/online users
  chat  -- join the chat room
  last  -- show recent logins
  weather -- show weather forecast

EOF
