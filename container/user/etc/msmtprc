# See DESIGN.md §2.2/§2.3: Postfix has no way to relay straight to a
# Unix-domain-socket next-hop, so a socat shim (started by the
# entrypoint) bridges a loopback TCP port to mail-service's socket.
# msmtp itself needs no other configuration -- it does no
# recipient-address completion, and doesn't need to; that gap is closed
# server-side by mail-service's `myorigin` (see §2.3).
account bbs
host 127.0.0.1
port 2525
tls off

# mail from GNU mailutils synthesizes a From: address automatically if one is
# not otherwise available, while mail from s-nail does not, which causes msmtp
# to reject the message. Setting auto_from on gets msmtp to synthesize the
# From: address for us.
auto_from on

account default : bbs
