FROM docker.io/alpine:3

# See DESIGN.md §5 "Image contents":
#   mailutils (not mailx -- mailx cannot read the Maildir format
#     mail-service delivers into, see DESIGN.md §2.4)
#   msmtp + socat  -- outbound relay path, see DESIGN.md §2.2/§2.3
#   dash           -- provisioned account's login shell
#   shadow         -- groupadd/useradd for per-session account provisioning
#   su-exec        -- minimal privilege drop before exec'ing into dash
#   curl + jq      -- user-service calls (lookup, presence, `users` command)
RUN apk add --no-cache \
    mailutils \
    msmtp \
    socat \
    dash \
    shadow \
    su-exec \
    curl \
    jq \
    bash \
    less \
    openvi \
    ed

# Alpine has no update-alternatives mechanism, so installing msmtp does
# not repoint /usr/sbin/sendmail at it -- it's left as busybox's own
# sendmail stub applet, which mailutils' `mail` invokes and which
# silently fails to actually send anything (confirmed by testing: `mail`
# reported "cannot send message" with no other clue). msmtp ships its
# own drop-in sendmail-compatible CLI, so this symlink is required.
RUN ln -sf /usr/bin/msmtp /usr/sbin/sendmail
RUN ln -sf /usr/bin/oex /usr/bin/ex

COPY syslesskey /etc/syslesskey
COPY mail.rc /etc/mail.rc
COPY msmtprc /etc/msmtprc
COPY profile /etc/bbs-profile
COPY users.sh /usr/local/bin/users
COPY news.sh /usr/local/bin/news
COPY chat.sh /usr/local/bin/chat
COPY help.sh /usr/local/bin/help
COPY helpfiles /helpfiles
COPY container-entrypoint.sh /container-entrypoint.sh
RUN chmod 755 /container-entrypoint.sh /usr/local/bin/*

# The container runs with `--read-only` (DESIGN.md §6), so /etc needs to
# be a writable tmpfs at `docker run` time (`--tmpfs /etc`) for
# groupadd/useradd to update /etc/passwd, /etc/group, /etc/shadow,
# /etc/gshadow, and their lock/temp files every session (confirmed by
# testing: without this, groupadd fails outright with "Read-only file
# system"). A tmpfs mount starts empty, wiping out everything apk/COPY
# put in /etc above -- this snapshot is what the entrypoint restores
# from on every container start, before provisioning the account.
RUN cp -a /etc /etc.orig

ENTRYPOINT ["/container-entrypoint.sh"]
