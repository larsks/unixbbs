set prompt="mail> " hold
# Without this, the header-summary listing (the "Sun Sep 13 14:01"
# column) is taken from the message's SMTP envelope date, which
# mailutils always renders in UTC regardless of TZ -- confirmed by
# testing against mailutils 3.21 on Alpine, where TZ had no effect on
# that column at all, even set to UTC itself. `datefield` switches the
# listing to the Date: header instead, which mailutils *does* convert
# to local time correctly.
set datefield
ignore Return-Path X-Original-To Delivered-To Received Message-ID User-Agent
