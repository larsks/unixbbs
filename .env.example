# Copy to .env and adjust as needed. Compose loads .env automatically.

# Which published image tag to pull when using pre-built images
# (`docker compose pull && docker compose up`). Ignored when building
# locally (`docker compose build` / `up --build`). Images are published
# to ghcr.io/larsks/unixbbs-<service>, each release tagged `latest`,
# `x.y.z`, `x.y`, and `x` -- e.g. TAG=1 tracks the latest 1.x.y release.
#TAG=latest

# Passed as a build arg to limit Go's build parallelism; useful on
# resource-constrained builders like a Raspberry Pi. Defaults to all
# cores.
#GOMAXPROCS=1
